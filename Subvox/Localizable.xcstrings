    "Read a public-domain speech or poem at your own pace. The words highlight as you go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un discurso o poema de dominio público a tu ritmo. Las palabras se resaltan a medida que avanzas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee un discurso o poema de dominio público a tu ritmo. Las palabras se resaltan a medida que avanzas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez un discours ou un poème du domaine public à votre rythme. Les mots sont surlignés au fur et à mesure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按自己的节奏朗读一篇公有领域的演讲或诗歌。读到哪里，词就高亮到哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按自己的節奏朗讀一篇公共領域的演講或詩歌。讀到哪裡，詞就醒目標示到哪裡。"
          }
        }
      }
    },
    "Read a short sentence aloud, then mouth it silently. About ten minutes a session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee una frase corta en voz alta y luego articúlala sin voz, solo con los labios. Unos diez minutos por sesión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee una frase corta en voz alta y luego articúlala sin voz, solo con los labios. Unos diez minutos por sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez une phrase courte à voix haute, puis articulez-la en silence, avec les lèvres. Environ dix minutes par session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先大声读一个短句，再不出声，只动嘴唇。每次约十分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先大聲讀一個短句，再不出聲，只動嘴唇。每次約十分鐘。"
          }
        }
      }
    },
