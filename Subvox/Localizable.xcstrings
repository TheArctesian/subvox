    "I understand the dataset is public (CC BY 4.0): anyone can download and reuse what I share, and published copies can't be fully withdrawn.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que el conjunto de datos es público (CC BY 4.0): cualquiera puede descargar y reutilizar lo que comparto, y las copias publicadas no se pueden retirar por completo."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que el conjunto de datos es público (CC BY 4.0): cualquiera puede descargar y reutilizar lo que comparto, y las copias publicadas no se pueden retirar por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que le jeu de données est public (CC BY 4.0) : tout le monde peut télécharger et réutiliser ce que je partage, et les copies publiées ne peuvent pas être entièrement retirées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解该数据集是公开的（CC BY 4.0）：任何人都可以下载并再次使用我分享的内容，已发布的副本无法完全撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解該資料集是公開的（CC BY 4.0）：任何人都可以下載並再次使用我分享的內容，已發布的副本無法完全撤回。"
          }
        }
      }
    },
