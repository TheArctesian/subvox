    "Subvox is an open research project teaching computers to understand silently mouthed words, from AirPods head motion and the shape of your lips.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subvox es un proyecto de investigación abierto que enseña a los ordenadores a entender palabras articuladas sin voz, a partir del movimiento de la cabeza con los AirPods y de la forma de tus labios."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Subvox es un proyecto de investigación abierto que enseña a los computadoras a entender palabras articuladas sin voz, a partir del movimiento de la cabeza con los AirPods y de la forma de tus labios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Subvox est un projet de recherche ouvert qui apprend aux ordinateurs à comprendre les mots articulés en silence, à partir des mouvements de tête des AirPods et de la forme de vos lèvres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Subvox 是一个开放的研究项目，目标是让电脑从 AirPods 的头部动作和嘴唇的形状，理解不出声、只动嘴唇说出的词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Subvox 是一個開放的研究專案，目標是讓電腦從 AirPods 的頭部動作和嘴唇的形狀，理解不出聲、只動嘴唇說出的詞。"
          }
        }
      }
    },
