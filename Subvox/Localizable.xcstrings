    "Untick any take you don't want to share. Dropped takes are left out of the upload; your local recording isn't changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca las tomas que no quieras compartir. Las tomas descartadas no se suben; tu grabación local no cambia."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca las tomas que no quieras compartir. Las tomas descartadas no se suben; tu grabación local no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décochez les prises que vous ne voulez pas partager. Les prises écartées ne sont pas envoyées ; votre enregistrement local reste inchangé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾选你不想分享的录音。取消的录音不会上传；你本机的录音不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾選你不想分享的錄音。取消的錄音不會上傳；你本機的錄音不會改變。"
          }
        }
      }
    },
    "Up to %lld training sentences per batch": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta %lld frases de entrenamiento por tanda"
          }
        },
