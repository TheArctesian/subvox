    "Didn't open, or opened a different page? Open the link again, or copy it into any browser where you're signed in to Hugging Face.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No se abrió o se abrió otra página? Abre el enlace de nuevo o cópialo en un navegador donde hayas iniciado sesión en Hugging Face."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No se abrió o se abrió otra página? Abre el enlace de nuevo o cópialo en un navegador donde hayas iniciado sesión en Hugging Face."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s’est ouvert, ou une autre page s’est affichée ? Rouvrez le lien, ou copiez-le dans un navigateur où vous êtes connecté à Hugging Face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有打开，或打开了别的页面？请再打开一次链接，或把链接拷贝到已登录 Hugging Face 的任意浏览器中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有開啟，或開啟了別的頁面？請再開啟一次連結，或把連結拷貝到已登入 Hugging Face 的任一瀏覽器中。"
          }
        }
      }
    },
