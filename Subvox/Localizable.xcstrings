    "%lld sentences. A take trains only when Whisper agrees with at least 85%% of it; otherwise it stays practice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld frases. Una toma solo se usa para entrenar si Whisper coincide con al menos el 85 %% de su contenido; si no, queda como práctica."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld frases. Una toma solo se usa para entrenar si Whisper coincide con al menos el 85 %% de su contenido; si no, queda como práctica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld phrases. Une prise n’est utilisée pour l’entraînement que si Whisper concorde avec au moins 85 %% de son contenu ; sinon, elle reste un simple exercice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个句子。一次录音只有在 Whisper 识别结果与内容至少 85%% 相符时才会用于训练，否则仅作练习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個句子。一次錄音只有在 Whisper 辨識結果與內容至少 85%% 相符時才會用於訓練，否則僅作練習。"
          }
        }
      }
    },
