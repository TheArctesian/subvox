    "Recordings stay on this Mac until you choose to share them. The camera only reads lip points; no video or photos are saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se quedan en este Mac hasta que decidas compartirlas. La cámara solo lee puntos de los labios; no se guardan videos ni fotos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se quedan en este Mac hasta que decidas compartirlas. La cámara solo lee puntos de los labios; no se guardan videos ni fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements restent sur ce Mac jusqu’à ce que vous choisissiez de les partager. La caméra ne lit que des points des lèvres ; aucune vidéo ni photo n’est enregistrée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音、AirPods 动作和嘴部关键点只保存在这台 Mac 上；只有你按“发送”才会分享。摄像头只用来提取嘴部关键点，不保存视频或照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音、AirPods 動作和嘴部關鍵點只保存在這台 Mac 上；只有你按「傳送」才會分享。相機只用來擷取嘴部關鍵點，不保存影片或照片。"
          }
        }
      }
    },
    "Recordings stay on this Mac. Sharing to the open community dataset is a separate, opt-in step.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se quedan en este Mac. Compartirlas con el conjunto de datos abierto de la comunidad es un paso aparte y opcional."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se quedan en este Mac. Compartirlas con el conjunto de datos abierto de la comunidad es un paso aparte y opcional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements restent sur ce Mac. Le partage vers le jeu de données communautaire ouvert est une étape distincte, facultative."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音只留在这台 Mac 上。分享到公开的社区数据集是另外一步，由你自愿选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音只留在這台 Mac 上。分享到公開的社群資料集是另外一步，由你自願選擇。"
          }
        }
      }
    },
    "Recordings stay on this Mac. You can still record community passages for your own use.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se quedan en este Mac. Aun así, puedes grabar pasajes de la comunidad para uso propio."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones se quedan en este Mac. Aun así, puedes grabar pasajes de la comunidad para uso propio."
          }
        },
        "fr": {
          "stringUnit": {
