        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以在“录音 › 分享录音”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以在「錄音 › 分享錄音」中更改。"
          }
        }
      }
    },
