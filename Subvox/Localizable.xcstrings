    "Withdrawing stops future uploads. To remove data you've already shared, email %@. Copies others have downloaded can't be recalled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirarlo detiene los envíos futuros. Para eliminar datos que ya compartiste, escribe a %@. Las copias que otros hayan descargado no se pueden recuperar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirarlo detiene los envíos futuros. Para eliminar datos que ya compartiste, escribe a %@. Las copias que otros hayan descargado no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retrait met fin aux envois futurs. Pour supprimer des données déjà partagées, écrivez à %@. Les copies téléchargées par d’autres ne peuvent pas être rappelées."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回后将不再上传。若要删除已分享的数据，请发邮件到 %@。他人已下载的副本无法收回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回後將不再上傳。若要刪除已分享的資料，請寄電子郵件到 %@。他人已下載的副本無法收回。"
          }
        }
      }
    },
    "Words that differ by one sound and look alike on the lips. Hear each pair, then say every word.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras que se distinguen por un solo sonido y se ven iguales en los labios. Escucha cada par y luego di cada palabra."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras que se distinguen por un solo sonido y se ven iguales en los labios. Escucha cada par y luego di cada palabra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mots qui diffèrent par un seul son et se ressemblent sur les lèvres. Écoutez chaque paire, puis dites chaque mot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只差一个发音、嘴形又很像的词。先听每一组，再逐个读出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只差一個發音、嘴形又很像的詞。先聽每一組，再逐個讀出來。"
          }
        }
      }
    },
