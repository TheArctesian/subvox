    "Put both AirPods in your ears. If it stays here, play something in Music or Safari and set Spatial Audio to Head Tracked in the AirPods menu.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los dos AirPods. Si sigue así, reproduce algo en Música o Safari y elige Audio espacial › Seguimiento de la cabeza en el menú de los AirPods."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los dos AirPods. Si sigue así, reproduce algo en Música o Safari y elige Audio espacial › Seguimiento de la cabeza en el menú de los AirPods."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les deux AirPods. Si rien ne change, lancez un son dans Musique ou Safari et choisissez Audio spatial › Suivi de la tête dans le menu des AirPods."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请戴上两只 AirPods。如果仍然没有反应，请在“音乐”或 Safari 中播放声音，并在 AirPods 菜单里把空间音频设为“头部追踪”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請戴上兩隻 AirPods。如果仍然沒有反應，請在「音樂」或 Safari 中播放聲音，並在 AirPods 選單裡把空間音訊設為「頭部追蹤」。"
          }
        }
      }
    },
    "Put in AirPods Pro and make sure they're the active output on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los AirPods Pro y asegúrate de que sean la salida activa de este Mac."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los AirPods Pro y asegúrate de que sean la salida activa de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez vos AirPods Pro et vérifiez qu’ils sont la sortie active de ce Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请戴上 AirPods Pro，并确认它们是这台 Mac 当前的输出设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請戴上 AirPods Pro，並確認它們是這台 Mac 目前的輸出裝置。"
          }
        }
      }
    },
    "Put in your AirPods, play something in Music or Safari, and set Spatial Audio to Head Tracked in the AirPods menu in the menu bar.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los AirPods, reproduce algo en Música o Safari y elige Audio espacial › Seguimiento de la cabeza en el menú de los AirPods de la barra de menús."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte los AirPods, reproduce algo en Música o Safari y elige Audio espacial › Seguimiento de la cabeza en el menú de los AirPods de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez vos AirPods, lancez un son dans Musique ou Safari et choisissez Audio spatial › Suivi de la tête dans le menu des AirPods de la barre des menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "戴上 AirPods，在“音乐”或 Safari 中播放声音，并在菜单栏的 AirPods 菜单里把空间音频设为“头部追踪”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "戴上 AirPods，在「音樂」或 Safari 中播放聲音，並在選單列的 AirPods 選單裡把空間音訊設為「頭部追蹤」。"
          }
        }
      }
    },
