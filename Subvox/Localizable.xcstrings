    "On this Mac: your voice as audio, AirPods head motion, and numeric lip and jaw points from the camera. Never video or photos.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este Mac: tu voz como audio, el movimiento de la cabeza de los AirPods y los puntos numéricos de labios y mandíbula de la cámara. Nunca vídeo ni fotos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "En este Mac: tu voz como audio, el movimiento de la cabeza de los AirPods y los puntos numéricos de labios y mandíbula de la cámara. Nunca vídeo ni fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur ce Mac : votre voix en audio, les mouvements de tête des AirPods et les points numériques des lèvres et de la mâchoire issus de la caméra. Jamais de vidéo ni de photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在这台 Mac 上：你的声音（音频）、AirPods 的头部动作，以及相机取得的嘴唇和下巴的数字坐标点。绝不录制视频或照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存在這台 Mac 上：你的聲音（音訊）、AirPods 的頭部動作，以及相機取得的嘴唇和下巴的數字座標點。絕不錄製影片或照片。"
          }
        }
      }
    },
