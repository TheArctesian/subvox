    "Draft wording pending a data-protection review.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacción provisional, pendiente de una revisión de protección de datos."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacción provisional, pendiente de una revisión de protección de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formulation provisoire, en attente d’une revue de protection des données."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字为草稿，尚待数据保护审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字為草稿，尚待資料保護審查。"
          }
        }
      }
    },
    "Drill": {
      "localizations": {
