    "Listen, say it aloud, then say it again silently, with your lips only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha, dilo en voz alta y vuelve a decirlo sin voz, solo con los labios."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha, dilo en voz alta y vuelve a decirlo sin voz, solo con los labios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez, dites-le à voix haute, puis répétez-le en silence, avec les lèvres seulement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先听，再出声读，然后不出声，只动嘴唇再读一遍。"
