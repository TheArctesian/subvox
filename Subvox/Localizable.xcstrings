    "Shows each one; you say it aloud, then mouth it silently. Command Return.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cada uno; lo dices en voz alta y luego lo articulas sin voz. Comando Retorno."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cada uno; lo dices en voz alta y luego lo articulas sin voz. Comando Retorno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche chaque élément ; vous le dites à voix haute, puis l’articulez en silence. Commande Retour."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐个显示；你先出声读，再不出声动嘴。按 Command–Return。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐個顯示；你先出聲讀，再不出聲動嘴。按 Command–Return。"
          }
        }
      }
    },
