    "You read short sentences aloud, then mouth them silently. About ten minutes a session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees frases cortas en voz alta y luego las articulas sin voz, solo con los labios. Unos diez minutos por sesión."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees frases cortas en voz alta y luego las articulas sin voz, solo con los labios. Unos diez minutos por sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lisez des phrases courtes à voix haute, puis vous les articulez en silence, avec les lèvres. Environ dix minutes par session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你先大声读短句，再不出声，只动嘴唇。每次约十分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你先大聲讀短句，再不出聲，只動嘴唇。每次約十分鐘。"
          }
        }
      }
    },
