    "Sounds are compared word by word, so a sound inside a correctly recognised word isn't checked yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos se comparan palabra por palabra, así que un sonido dentro de una palabra bien reconocida aún no se comprueba."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos se comparan palabra por palabra, así que un sonido dentro de una palabra bien reconocida aún no se comprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons sont comparés mot par mot : un son à l’intérieur d’un mot correctement reconnu n’est donc pas encore vérifié."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发音是按整个词来比对的，所以已被正确识别的词里的单个发音，目前还不会被检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發音是按整個詞來比對的，所以已被正確辨識的詞裡的單個發音，目前還不會被檢查。"
          }
        }
      }
    },
