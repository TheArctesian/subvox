    "Confirmation approves the prompt as the label. Invalid motion and unavailable word timings are still excluded from the affected method.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmación aprueba el texto como etiqueta. Los movimientos no válidos y los tiempos de palabras no disponibles siguen excluidos del método afectado."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmación aprueba el texto como etiqueta. Los movimientos no válidos y los tiempos de palabras no disponibles siguen excluidos del método afectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La confirmation valide le texte comme étiquette. Les mouvements non valides et les temps de mots indisponibles restent exclus de la méthode concernée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后，提示文字将作为标注。无效的动作和缺少的词语时间，仍会从相关方法中排除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後，提示文字將作為標註。無效的動作和缺少的詞語時間，仍會從相關方法中排除。"
          }
        }
      }
    },
