     "gloss": "Does it have air conditioning?"
    },
    {
     "text": "¿Se admiten mascotas?",
     "gloss": "Are pets allowed?"
    },
    {
     "text": "¿Se puede visitar hoy?",
     "gloss": "Can we view it today?"
    },
    {
     "text": "Me interesa el piso.",
     "gloss": "I'm interested in the flat."
    }
   ]
  },
