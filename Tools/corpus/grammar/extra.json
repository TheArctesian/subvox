   "id": "healthcare",
   "level": "B1",
   "topic": "Everyday life",
   "title": "At work: healthcare",
   "note": "What a nurse or carer says to patients, including numbers that are easy to confuse.",
   "phrases": [
    {
     "text": "What's your date of birth?",
     "gloss": "Checking identity"
    },
    {
     "text": "Can you spell your surname for me?",
     "gloss": "Spelling names on the phone or ward"
    },
    {
     "text": "Are you allergic to anything?",
     "gloss": "Before giving medication"
    },
    {
     "text": "I'm going to take your blood pressure.",
     "gloss": "Explaining what you'll do"
    },
    {
     "text": "How bad is the pain, from one to ten?",
     "gloss": "Pain score"
    },
    {
     "text": "Have you had anything to eat today?",
     "gloss": "Before a procedure"
    },
    {
     "text": "Fifteen milligrams, not fifty.",
     "gloss": "Stress the second syllable: fifTEEN vs FIFty"
    },
    {
     "text": "I'll be back in five minutes.",
     "gloss": "Reassuring a patient"
    }
   ]
  },
