      "ʒ i ʁ e",
      "p a ʁ",
      "l a",
      "f o ʁ ɛ",
      "ʒ i ʁ e",
      "p a ʁ",
      "l a",
      "m ɔ̃ t a ɲ"
     ]
    },
    {
