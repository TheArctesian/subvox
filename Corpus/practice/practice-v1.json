  {
   "id": "sonnet-18",
   "language": "en",
   "kind": "poem",
   "title": "Sonnet 18",
   "author": "William Shakespeare",
   "year": 1609,
   "lines": [
    {
     "text": "Shall I compare thee to a summer's day?",
